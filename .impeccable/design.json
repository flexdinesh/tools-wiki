  "narrative": {
    "northStar": "Reference Atlas",
    "overview": "A carefully typeset reference for developers working in the middle of a task. The reading pane and navigation share one paper surface; thin rules define the catalog rails, while cobalt shows the path through them. The same structure turns deep blue-green in dark mode.\n\nFraunces gives page titles, sections, and command headings an editorial voice. IBM Plex Sans keeps explanations readable; IBM Plex Mono marks commands, tool names, section labels, and keys. Thin rules and square highlights organize dense information without adding visual weight.",
    "keyCharacteristics": [
      "Paired warm-paper and blue-green themes with cobalt wayfinding.",
      "Serif titles and command headings, sans prose, and mono labels and syntax.",
      "Flat directory rows, compact controls, and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Paired Theme Rule",
        "body": "Apply the matching light or dark roles together. Keep link and focus treatment cobalt in both.",
        "section": "colors"
      },
      {
        "name": "The Three Voice Rule",
        "body": "Use serif for major headings, sans for explanation and controls, mono for reference structure and syntax.",
        "section": "typography"
      },
      {
        "name": "The Flat Reference Rule",
        "body": "Use tonal surfaces and thin (1px) borders. Directory rows and pagination have no shadow. Terminal examples alone use a hard, unblurred (4px) offset in the active tint.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** pair each theme's paper, ink, line, and cobalt tokens.",
      "**Do** keep Fraunces headings, sans reading text, and mono reference labels.",
      "**Do** preserve native controls, visible focus, and reduced-motion support.",
      "**Do** stack directory content on narrow screens and scroll wide references locally."
    ],
    "donts": [
      "**Don't** add diffuse shadows to reference surfaces or window dots to terminal headers.",
