    {
      "name": "Tool directory row",
      "kind": "custom",
      "refersTo": "tool-row",
      "description": "Continuous catalog row; contents stack below 38rem.",
      "html": "<a class=\"ds-row\" href=\"/cheatsheets/git/\"><span class=\"ds-row-stack\"><span class=\"ds-row-name\">git</span><span class=\"ds-row-description\">Config, commit, log, push, worktree, patch, diff, show, pipelines, and stacked rebase.</span></span><svg class=\"ds-row-arrow\" aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"m17.92 11.62-.01-.03a1 1 0 0 0-.2-.3l-5-5a1 1 0 0 0-1.42 1.42L14.59 11H5a1 1 0 0 0 0 2h9.59l-3.3 3.3a1 1 0 0 0 1.42 1.4l5-5a1 1 0 0 0 .21-1.08Z\"/></svg></a>",
      "css": ".ds-row{display:flex;align-items:center;gap:1rem;padding:.85rem .5rem;border-bottom:1px solid var(--atlas-line);color:inherit;text-decoration:none;transition:background-color 160ms cubic-bezier(.16,1,.3,1)}.ds-row-stack{display:grid;grid-template-columns:9rem minmax(0,1fr);align-items:baseline;gap:1.25rem;flex:1}.ds-row-name{color:var(--atlas-blue);font:600 .9rem/1.4 var(--font-mono)}.ds-row-description{color:var(--atlas-text);font:400 .875rem/1.5 var(--font-sans)}.ds-row-arrow{color:var(--atlas-blue);transition:transform 160ms cubic-bezier(.16,1,.3,1)}.ds-row:is(:hover,:focus-visible){background:var(--atlas-active)}.ds-row:is(:hover,:focus-visible) .ds-row-arrow{transform:translateX(3px)}.ds-row:focus-visible{outline:2px solid var(--atlas-blue);outline-offset:3px}@media(max-width:37.999rem){.ds-row{align-items:start}.ds-row-stack{grid-template-columns:minmax(0,1fr);gap:.25rem}.ds-row-arrow{margin-top:.2rem}}@media(prefers-reduced-motion:reduce){.ds-row,.ds-row-arrow{transition:none}}"
    },
    {
      "name": "Current navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Square cobalt sidebar highlight.",
      "html": "<nav class=\"ds-nav\"><a href=\"/cheatsheets/git/\" aria-current=\"page\">git</a><a href=\"/cheatsheets/docker/\">docker</a></nav>",
      "css": ".ds-nav{background:var(--atlas-side);padding:.5rem}.ds-nav a{display:block;padding:.27rem .5rem;border-radius:0;color:var(--atlas-text);font:400 .81rem/1.6 var(--font-mono);text-decoration:none}.ds-nav a:hover{color:var(--atlas-blue);background:var(--atlas-active)}.ds-nav a[aria-current=page]{color:var(--atlas-blue);background:var(--atlas-active);box-shadow:inset 1px 0 0 var(--atlas-blue);font-weight:600}.ds-nav a:focus-visible{outline:2px solid var(--atlas-blue);outline-offset:3px}@media(max-width:49.999rem){.ds-nav a{min-height:2.75rem;padding-block:.4rem}}"
    },
    {
      "name": "Search trigger",
      "kind": "button",
      "refersTo": "search-trigger",
      "description": "Flat native search entry.",
      "html": "<button class=\"ds-search\" type=\"button\">Search <kbd>Ctrl K</kbd></button>",
      "css": ".ds-search{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;min-height:2.3rem;padding:.35rem .65rem;border:1px solid var(--atlas-line);border-radius:0;color:var(--atlas-text);background:var(--atlas-paper);font:400 .8125rem/1.4 var(--font-sans);cursor:pointer}.ds-search kbd{color:var(--atlas-muted);font:400 .6875rem/1.4 var(--font-mono)}.ds-search:hover{color:var(--atlas-blue);border-color:var(--atlas-blue)}.ds-search:focus-visible{outline:2px solid var(--atlas-blue);outline-offset:3px}.ds-search:disabled{cursor:wait;opacity:.65}@media(max-width:49.999rem){.ds-search{min-height:2.75rem}}"
    },
    {
      "name": "Reference table",
      "kind": "custom",
      "refersTo": "table-cell",
      "description": "Compact table with local scrolling.",
      "html": "<div class=\"ds-scroll\"><table class=\"ds-table\"><thead><tr><th>Key</th><th>Purpose</th><th>Result</th></tr></thead><tbody><tr><td>dd</td><td>Delete current line.</td><td>Current line is cut.</td></tr><tr><td>yy</td><td>Yank current line.</td><td>Current line is copied.</td></tr></tbody></table></div>",
      "css": ".ds-scroll{overflow-x:auto}.ds-table{width:100%;border-collapse:collapse;color:var(--atlas-text);font:400 .875rem/1.65 var(--font-sans);font-variant-numeric:tabular-nums}.ds-table th{color:var(--atlas-ink);background:var(--atlas-soft);font-weight:600;text-align:start}.ds-table :is(th,td){padding:.55rem .75rem;border-bottom:1px solid var(--atlas-line);vertical-align:top}.ds-table :is(th,td):first-child{min-width:6rem}.ds-table tbody tr:nth-child(even){background:var(--atlas-ground)}@media(max-width:49.999rem){.ds-table :is(th,td):not(:first-child){min-width:14rem}}@media(min-width:50rem){.ds-table :is(th,td):first-child{min-width:8rem}}"
    },
