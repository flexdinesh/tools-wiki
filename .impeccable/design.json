      "css": ".ds-minimal{display:inline-flex;align-items:center;min-height:2.6rem;padding:.5rem .85rem;border:1px solid transparent;border-radius:2px;background:transparent;color:var(--atlas-ink);font:600 .8125rem/1.4 var(--font-sans);text-decoration:none}.ds-minimal:hover{text-decoration:underline}.ds-minimal:focus-visible{outline:2px solid var(--atlas-blue);outline-offset:3px}@media(max-width:49.999rem){.ds-minimal{min-height:2.75rem}}"
