    {
      "name": "Tool row",
      "kind": "custom",
      "refersTo": "tool-row",
      "description": "Continuous index row; name and description stack below 38rem.",
      "html": "<a class=\"ds-row\" href=\"/cheatsheets/git/\"><span class=\"ds-stack\"><span class=\"ds-name\">git</span><span class=\"ds-description\">Config, commit, log, push, worktree, patch, diff, and stacked rebase.</span></span><svg class=\"ds-arrow\" aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"m17.92 11.62-.01-.03a1 1 0 0 0-.2-.3l-5-5a1 1 0 0 0-1.42 1.42L14.59 11H5a1 1 0 0 0 0 2h9.59l-3.3 3.3a1 1 0 0 0 1.42 1.4l5-5a1 1 0 0 0 .21-1.08Z\"/></svg></a>",
      "css": ".ds-row{display:grid;grid-template-columns:1fr auto;align-items:center;gap:1rem;padding:.75rem .5rem;border-bottom:1px solid var(--wiki-border,#d8e3dc);background:transparent;text-decoration:none;transition:background-color 160ms cubic-bezier(.16,1,.3,1)}.ds-stack{display:grid;grid-template-columns:8.5rem minmax(0,1fr);gap:1rem;align-items:baseline}.ds-name{font-family:var(--font-mono,'JetBrains Mono',monospace);font-size:.875rem;font-weight:600;letter-spacing:-.025em;color:var(--wiki-teal,#18786b)}.ds-description{font-family:var(--font-sans,Inter,sans-serif);font-size:.8125rem;line-height:1.6;color:var(--sl-color-gray-2,#4b5d55)}.ds-arrow{color:var(--sl-color-text-accent,#146c60);transition:transform 160ms cubic-bezier(.16,1,.3,1)}.ds-row:is(:hover,:focus-within){background:var(--wiki-soft,#edf4ef)}.ds-row:is(:hover,:focus-within) .ds-arrow{transform:translateX(3px)}.ds-row:focus-visible{outline:2px solid var(--sl-color-text-accent,#146c60);outline-offset:3px}@media(max-width:37.999rem){.ds-stack{grid-template-columns:minmax(0,1fr);gap:.25rem}.ds-row{align-items:start}.ds-arrow{margin-top:.2rem}}@media(prefers-reduced-motion:reduce){.ds-row,.ds-arrow{transition:none}}"
    },
