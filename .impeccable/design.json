      "html": "<a class=\"ds-primary\" href=\"/cheatsheets/git/\">Browse cheatsheets</a>",
      "css": ".ds-primary{display:inline-flex;align-items:center;min-height:2.6rem;padding:.5rem .85rem;border:1px solid var(--atlas-blue);border-radius:2px;background:var(--atlas-blue);color:var(--sl-color-text-invert);font:600 .8125rem/1.4 var(--font-sans);text-decoration:none}.ds-primary:hover{background:var(--atlas-blue-hover);border-color:var(--atlas-blue-hover)}.ds-primary:focus-visible{outline:2px solid var(--atlas-blue);outline-offset:3px}@media(max-width:49.999rem){.ds-primary{min-height:2.75rem}}"
    },
