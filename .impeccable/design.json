      "css": ".ds-primary{font-family:var(--font-sans,Inter,sans-serif);display:inline-flex;align-items:center;min-height:2.5rem;padding:.5rem .75rem;border-radius:6px;font-size:.8125rem;font-weight:600;text-decoration:none;border:1px solid var(--wiki-action,#146c60);color:#fff;background:var(--wiki-action,#146c60)}.ds-primary:hover{background:var(--wiki-action-hover,#0f564c);border-color:var(--wiki-action-hover,#0f564c)}.ds-primary:focus-visible{outline:2px solid var(--sl-color-text-accent,#146c60);outline-offset:3px}@media(max-width:49.999rem){.ds-primary{min-height:2.75rem}}"
