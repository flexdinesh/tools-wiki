---
const { entry } = Astro.locals.starlightRoute;
const section = entry.id.startsWith("neovim/") ? "Neovim Plugins" : "Cheatsheets";
const sectionHref = section === "Neovim Plugins" ? "/#neovim-plugins" : "/#cheatsheets";
const showBreadcrumb = entry.id.includes("/");
---

{showBreadcrumb && (
  <nav class="wiki-breadcrumb" aria-label="Breadcrumb">
    <a href={sectionHref}>{section}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{entry.data.title}</span>
  </nav>
)}
<h1 id="_top">{entry.data.title}</h1>
{showBreadcrumb && entry.data.description && (
  <p class="wiki-summary">{entry.data.description}</p>
)}

<style>
  .wiki-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3125rem;
    color: var(--wiki-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .wiki-breadcrumb a { color: var(--wiki-accent); font-weight: 500; text-decoration: none; }
  .wiki-breadcrumb a:hover { text-decoration: underline; }
  h1 {
    margin-top: 0.375rem;
    color: var(--wiki-ink);
    font: 600 1.875rem/1.1 var(--font-sans);
    letter-spacing: -0.025em;
  }
  .wiki-summary {
    max-width: 72ch;
    margin-top: 0.25rem;
    color: var(--wiki-text);
    font-size: 0.90625rem;
    line-height: 1.5;
  }
</style>
