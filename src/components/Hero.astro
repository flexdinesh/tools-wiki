---
import { LinkButton } from "@astrojs/starlight/components";
import { getCollection } from "astro:content";

const { entry } = Astro.locals.starlightRoute;
const { data } = entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const docs = await getCollection("docs");
const lines = [
  { label: "Cheatsheets", href: "#cheatsheets", line: "cheatsheets", count: docs.filter(doc => doc.id.startsWith("cheatsheets/")).length },
  { label: "Neovim Plugins", href: "#neovim-plugins", line: "neovim", count: docs.filter(doc => doc.id.startsWith("neovim/")).length },
];
---

<div class="wiki-hero">
  <div class="copy">
    <h1 id="_top" data-page-title set:html={title} />
    <p>
      {tagline && <span set:html={tagline} />}
      Use <kbd>ctrl+k</kbd> / <kbd>cmd+k</kbd> to search commands.
    </p>
  </div>
  {
    actions.length > 0 && (
      <div class="actions">
        {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => {
          const iconName = icon && "name" in icon ? icon.name : undefined;
          return (
            <LinkButton {href} {variant} icon={iconName} class:list={[className]} {...attrs}>
              {text}
              {icon && "html" in icon && <Fragment set:html={icon.html} />}
            </LinkButton>
          );
        })}
      </div>
    )
  }
</div>
<nav class="line-key" aria-label="Collections">
  {lines.map(({ label, href, line, count }) => (
    <a href={href} data-line={line}><span class="line-mark" aria-hidden="true" />{label}<span class="line-count">{count}</span></a>
  ))}
</nav>

<style>
  .wiki-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1.125rem;
    padding: var(--wiki-space-page-block) var(--sl-content-pad-x);
    border-bottom: 1px solid var(--wiki-line-strong);
  }
  h1 {
    margin: 0 0 0.25rem;
    color: var(--wiki-ink);
    font: 600 var(--wiki-type-display)/1.1 var(--font-sans);
    letter-spacing: -0.025em;
  }
  p { margin: 0; color: var(--wiki-text); font-size: var(--wiki-type-body); line-height: 1.5; }
  kbd {
    padding: 0 0.25rem;
    border: 1px solid var(--wiki-line);
    background: var(--wiki-ground);
    font: 500 var(--wiki-type-key-large)/1.25rem var(--font-mono);
  }
  .actions :global(.sl-link-button) {
    min-height: var(--wiki-size-action);
    margin: 0;
    padding: 0 var(--wiki-space-cell-inline);
    border-radius: 0;
    font-size: var(--wiki-type-compact);
    font-weight: 500;
    white-space: nowrap;
  }
  .actions :global(.sl-link-button.primary) {
    border-color: var(--wiki-accent);
    background: var(--wiki-accent);
    color: var(--sl-color-text-invert);
  }
  .actions :global(.sl-link-button.primary:hover) {
    border-color: var(--wiki-accent-hover);
    background: var(--wiki-accent-hover);
  }
  .line-key {
    display: flex;
    min-height: var(--wiki-size-key-strip);
    border-bottom: 1px solid var(--wiki-line);
  }
  .line-key a {
    display: flex;
    align-items: center;
    gap: 0.4375rem;
    padding-inline: var(--sl-content-pad-x);
    border-inline-end: 1px solid var(--wiki-line);
    color: var(--wiki-ink);
    font-size: var(--wiki-type-compact);
    font-weight: 600;
    text-decoration: none;
  }
  .line-key a:hover { background: var(--wiki-active); }
  .line-key a:focus-visible { outline-offset: -2px; }
  .line-mark { width: 0.5rem; height: 0.5rem; background: var(--wiki-accent); }
  [data-line="neovim"] .line-mark { background: var(--wiki-line-neovim); }
  .line-count { color: var(--wiki-muted); font: 400 var(--wiki-type-count) var(--font-mono); }
  @media (max-width: 49.999rem) {
    .wiki-hero { grid-template-columns: minmax(0, 1fr); }
    .actions :global(.sl-link-button) { min-height: 2.75rem; }
    .line-key a { flex: 1; min-height: 2.75rem; padding-inline: 1rem; }
  }
</style>
