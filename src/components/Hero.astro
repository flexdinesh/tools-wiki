---
import { Image } from "astro:assets";
import DraftContentNotice from "virtual:starlight/components/DraftContentNotice";
import { LinkButton } from "@astrojs/starlight/components";

const { entry } = Astro.locals.starlightRoute;
const { data } = entry;
const { title = data.title, tagline, image, actions = [] } = entry.data.hero || {};
const showSearchTip = data.title === "tools wiki";

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;

if (image) {
  if ("file" in image) {
    darkImage = image.file;
  } else if ("dark" in image) {
    darkImage = image.dark;
    lightImage = image.light;
  } else {
    rawHtml = image.html;
  }
}
---

<div class:list={["hero", { "wiki-hero": showSearchTip }]}>
  {
    darkImage && (
      <Image
        src={darkImage}
        loading="eager"
        decoding="async"
        width={400}
        height={400}
        alt={image?.alt || ""}
        class:list={{ "light:sl-hidden": Boolean(lightImage) }}
      />
    )
  }
  {
    lightImage && (
      <Image
        src={lightImage}
        loading="eager"
        decoding="async"
        width={400}
        height={400}
        alt={image?.alt || ""}
        class="dark:sl-hidden"
      />
    )
  }
  {rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <h1 id="_top" data-page-title set:html={title} />
      {data.draft && <DraftContentNotice />}
      {tagline && <div class="tagline"><span set:html={tagline} /></div>}
      {
        showSearchTip && (
          <div class="search-tip">Use <kbd>ctrl+k</kbd> / <kbd>cmd+k</kbd> to search commands.</div>
        )
      }
    </div>
    {
      actions.length > 0 && (
        <div class="sl-flex actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => {
            const iconName = icon && "name" in icon ? icon.name : undefined;
            return (
              <LinkButton {href} {variant} icon={iconName} class:list={[className]} {...attrs}>
                {text}
                {icon && "html" in icon && <Fragment set:html={icon.html} />}
              </LinkButton>
            );
          })}
        </div>
      )
    }
  </div>
</div>

<style>
  .hero { display: grid; gap: 1.5rem; padding-block: 1rem 0.5rem; }
  .hero > img, .hero > .hero-html {
    object-fit: contain; width: min(70%, 20rem); height: auto; margin-inline: auto;
  }
  .stack { flex-direction: column; gap: 1.5rem; }
  .copy { flex-direction: column; align-items: flex-start; gap: 0.45rem; }
  h1 {
    color: var(--atlas-ink); font-family: var(--font-display);
    font-size: clamp(3.5rem, 7vw, 5.5rem); font-weight: 600;
    letter-spacing: -0.035em; line-height: 1.03; text-wrap: balance;
  }
  .tagline { color: var(--atlas-text); font-size: 1.1rem; line-height: 1.6; }
  .search-tip { color: var(--atlas-muted); font-size: 0.75rem; line-height: 1.8; }
  .search-tip kbd {
    padding: 0.12em 0.35em; border: 1px solid var(--atlas-line); border-radius: 2px;
    color: var(--atlas-blue); background: var(--atlas-ground);
    font-family: var(--font-mono); font-size: 0.6875rem;
  }
  .actions { gap: 0.5rem; flex-wrap: wrap; justify-content: flex-start; }
  .hero :global(.sl-link-button) {
    min-height: 2.6rem; padding: 0.5rem 0.85rem; border-radius: 2px;
    font-size: 0.8125rem; font-weight: 600;
  }
  .hero :global(.sl-link-button.primary) {
    color: var(--sl-color-text-invert); background: var(--atlas-blue); border-color: var(--atlas-blue);
  }
  .hero :global(.sl-link-button.primary:hover) {
    background: var(--atlas-blue-hover); border-color: var(--atlas-blue-hover);
  }
  @media (min-width: 50rem) {
    .wiki-hero > .stack { flex-direction: row; align-items: end; justify-content: space-between; gap: 2rem; }
    .hero:has(> img, > .hero-html) { grid-template-columns: 1fr 1fr; }
    .hero > img, .hero > .hero-html { order: 2; width: min(100%, 25rem); }
  }
  @media (max-width: 49.999rem) { .hero :global(.sl-link-button) { min-height: 2.75rem; } }
</style>
