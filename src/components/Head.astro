<!-- Privacy-friendly analytics by Plausible -->
<script async src="https://plausible.deebox.xyz/js/pa-udA0PJ0Wycc1FPqtx8ycv.js"></script>
<script>
  const plausible: Plausible = window.plausible ?? function (...args: unknown[]) {
    (plausible.q ??= []).push(args);
  };
  plausible.init ??= (options = {}) => { plausible.o = options; };
  window.plausible = plausible;
  plausible.init();
</script>

